{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/devcontainer/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "cmake/conan_provider.cmake",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
        "Qt6_ROOT": "$penv{Qt6_ROOT}"
      }
    },
    {
      "name": "debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      },
      "inherits": [ "base" ]
    },
    {
      "name": "release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      },
      "inherits": [ "base" ]
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "targets": [ "cs2guiserver", "tests" ]
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [ "cs2guiserver" ]
    }
  ]
}
